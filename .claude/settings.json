{
  "permissions": {
    "allow": [
      "PowerShell(Get-ChildItem D:\\\\UI\\\\official\\\\starter-kit -Recurse -Depth 3 | Where-Object {!$_.PSIsContainer} | Select-Object -First 40 | ForEach-Object { $_.FullName.Replace\\('D:\\\\UI\\\\official\\\\starter-kit\\\\',''\\) })",
      "PowerShell(Get-ChildItem D:\\\\UI\\\\official\\\\photoback-campaign -Recurse | Where-Object {!$_.PSIsContainer} | ForEach-Object { $_.FullName.Replace\\('D:\\\\UI\\\\official\\\\photoback-campaign\\\\',''\\) } | Sort-Object)"
    ],
    "deny": [
      "Edit(**/CLAUDE.md)",
      "Write(**/CLAUDE.md)",
      "Edit(**/.clauderules)",
      "Write(**/.clauderules)",
      "Edit(**/tailwind.config.ts)",
      "Write(**/tailwind.config.ts)",
      "Edit(**/components.json)",
      "Write(**/components.json)",
      "Edit(**/tsconfig.json)",
      "Write(**/tsconfig.json)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Edit(.claude/hooks/**)",
      "Write(.claude/hooks/**)",
      "Edit(.claude/commands/**)",
      "Write(.claude/commands/**)",
      "Edit(.claude/agents/**)",
      "Write(.claude/agents/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/protect-governance.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check-on-write.js"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/auto-commit.js"
          }
        ]
      }
    ]
  }
}
